    {
      "parameters": {
        "jsCode": "// 1. Get the raw text. \n// We use Object.values()[0] in case the API puts the string in a random key.\nconst items = $input.all();\nlet results = [];\n\nfor (const item of items) {\n  let rawData = item.json.data || Object.values(item.json)[0];\n\n  if (typeof rawData !== 'string') continue;\n\n  // 2. Clean up the \"noise\" (Non-breaking spaces and massive line breaks)\n  let cleanData = rawData.replace(/\\u00a0/g, ' ').replace(/\\s+/g, ' ').trim();\n\n  // 3. Fix the trailing comma if it exists at the very end\n  cleanData = cleanData.replace(/,$/, \"\");\n\n  try {\n    // 4. Wrap in braces and parse\n    const parsed = JSON.parse(`{ ${cleanData} }`);\n    results.push({ json: parsed });\n  } catch (e) {\n    results.push({ json: { error: \"Parse failed\", original: rawData.substring(0, 50) } });\n  }\n}\n\nreturn results;"
      },
