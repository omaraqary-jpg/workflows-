    {
      "parameters": {
        "jsCode": "// 1. Function to find the property containing your data (looking for 'ref_no')\nconst findRawString = (obj) => {\n  for (let key in obj) {\n    if (typeof obj[key] === 'string' && obj[key].includes('ref_no')) {\n      return obj[key];\n    }\n    if (typeof obj[key] === 'object' && obj[key] !== null) {\n      let found = findRawString(obj[key]);\n      if (found) return found;\n    }\n  }\n  return null;\n};\n\nconst rawData = findRawString($input.item.json);\n\n// 2. Safety check\nif (!rawData) {\n  return { \n    json: { \n      error: \"Could not find the property string.\",\n      tip: \"Ensure 'Response Format' in your HTTP Request node is set to 'Text' or 'JSON'.\",\n      debug_input: $input.item.json \n    } \n  };\n}\n\n// 3. Clean up non-breaking spaces and whitespace\nlet cleanData = rawData.replace(/\\u00a0/g, ' ').replace(/\\s+/g, ' ').trim();\n\n// 4. Remove trailing comma (very important for your specific data)\ncleanData = cleanData.replace(/,$/, \"\");\n\n// 5. Wrap and Parse\ntry {\n  const jsonString = `{ ${cleanData} }`;\n  const result = JSON.parse(jsonString);\n  return { json: result };\n} catch (error) {\n  return { json: { error: \"JSON Parse failed\", message: error.message, data: cleanData } };\n}"
      },
